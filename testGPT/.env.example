# TestingGPT Configuration
# Copy this file to .env and fill in your own API keys
# cp .env.example .env

# =============================================================================
# LLM Provider — choose ONE and fill it in
# =============================================================================

# Option 1: Groq (fast, free tier available) — https://console.groq.com/keys
GROQ_API_KEY=""
# Multiple Groq keys for round-robin (comma-separated, optional)
GROQ_API_KEYS=""

# Option 2: OpenRouter (access many models) — https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# Option 3: Google Gemini — https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=""

# Option 4: OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# Option 5: DeepSeek — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=""

# Option 6: NVIDIA NIM (Llama, Nemotron, etc.) — https://build.nvidia.com/
llama_3.1_70B=""
lama_3.1_70B_model="meta/llama-3.1-70b-instruct"
nemotron-3-super-120b-a12b=""
model="nvidia/nemotron-3-super-120b-a12b"
base_url="https://integrate.api.nvidia.com/v1"

# =============================================================================
# Auth Mode — which provider to use as default
# Options: groq | openrouter | gemini | openai | deepseek | local
# =============================================================================
PENTESTGPT_AUTH_MODE="groq"

# =============================================================================
# Claude (if using Claude Code inside container)
# =============================================================================
# Configure with: make config (inside container)
# Optional: override model
LLM_MODEL=claude-sonnet-4-5-20250929

# =============================================================================
# Optional: Claude OAuth cookie (not needed for API key auth)
# =============================================================================
CHATGPT_COOKIE=""
